{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dennytwse",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "assets": {
    "directory": "./static/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "denny123",
      "database_id": "4239e9da-275f-4876-99be-dcfe8295546b",
      "migrations_dir": "migrations"
    }
  ]
}
